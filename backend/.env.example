# ==============================================================================
# MITYRA Node Backend — Environment Variables
# ==============================================================================
# Copy to .env and fill in your values.
# All variables here are server-only secrets — never exposed to the browser.
# ==============================================================================

# ─── APPLICATION ─────────────────────────────────────────────────────────────
PORT=5002
NODE_ENV=development

# ─── CORS / FRONTEND ────────────────────────────────────────────────────────
# Set to your Netlify URL in production (e.g. https://mityra.netlify.app)
FRONTEND_URL=http://localhost:3002

# ─── FIREBASE ADMIN ─────────────────────────────────────────────────────────
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"

# ─── VTO (Virtual Try-On) ───────────────────────────────────────────────────
# AWS GPU backend URL — change this when switching to new L40S instance
AWS_VTO_URL=http://YOUR_AWS_GPU_IP:8000

# ─── CLOUDINARY ─────────────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ─── PRODUCT SCRAPING / SEARCH ──────────────────────────────────────────────
RAPIDAPI_KEY=
REACT_APP_RAPIDAPI_KEY=
SCRAPINGDOG_API_KEY=
QUICKCOMMERCE_API_KEY=

# ─── AI ──────────────────────────────────────────────────────────────────────
GEMINI_API_KEY=
OPENAI_API_KEY=

# ─── ADMIN ───────────────────────────────────────────────────────────────────
ADMIN_EMAIL=
ADMIN_PASSWORD=
JWT_SECRET=

# ─── PAYMENTS ────────────────────────────────────────────────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ─── FIREBASE (MOCK) ────────────────────────────────────────────────────────
FORCE_MOCK_FIREBASE=false
