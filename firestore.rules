rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
  
    // Helper function to check if the user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function to check if request is from the owner of the document
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Users Collection rules
    match /users/{userId} {
      allow read, write: if isOwner(userId);
    }

    // Wardrobe Collection rules
    match /wardrobe/{itemId} {
      allow read, create, update, delete: if isAuthenticated() && (
        resource == null || resource.data.userId == request.auth.uid
      ) && (
        request.resource == null || request.resource.data.userId == request.auth.uid
      );
    }

    // Tryons Collection rules
    match /tryons/{tryonId} {
      allow read, create, update, delete: if isAuthenticated() && (
        resource == null || resource.data.userId == request.auth.uid
      ) && (
        request.resource == null || request.resource.data.userId == request.auth.uid
      );
    }

    // aiChats Collection rules
    match /aiChats/{chatId} {
      allow read, create, update, delete: if isAuthenticated() && (
        resource == null || resource.data.userId == request.auth.uid
      ) && (
        request.resource == null || request.resource.data.userId == request.auth.uid
      );
    }

    // outfits Collection rules
    match /outfits/{outfitId} {
      allow read, create, update, delete: if isAuthenticated() && (
        resource == null || resource.data.userId == request.auth.uid
      ) && (
        request.resource == null || request.resource.data.userId == request.auth.uid
      );
    }

    // recommendations Collection rules
    match /recommendations/{recId} {
      allow read, create, update, delete: if isAuthenticated() && (
        resource == null || resource.data.userId == request.auth.uid
      ) && (
        request.resource == null || request.resource.data.userId == request.auth.uid
      );
    }

    // adWatches Collection rules
    match /adWatches/{watchId} {
      allow read, create, update, delete: if isAuthenticated() && (
        resource == null || resource.data.userId == request.auth.uid
      ) && (
        request.resource == null || request.resource.data.userId == request.auth.uid
      );
    }

    // SavedLooks Collection rules
    match /savedLooks/{lookId} {
      allow read, create, update, delete: if isAuthenticated() && (
        resource == null || resource.data.userId == request.auth.uid
      ) && (
        request.resource == null || request.resource.data.userId == request.auth.uid
      );
    }

    // Wallets Collection rules
    match /wallets/{userId} {
      allow read: if isOwner(userId);
      allow write: if false; // Only server can write
    }

    // Credit Ledger rules
    match /credit_ledger/{entryId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow write: if false; // Only server can write
    }

    // Payment Transactions rules
    match /payment_transactions/{txId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow write: if false; // Only server can write
    }

    // Default block rule for all other database collections (e.g. analytics, activityLogs)
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
