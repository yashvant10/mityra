# ==============================================================================
# MITYRA / TRYONX — MASTER ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# ==============================================================================
# Instructions:
# 1. Copy this file to .env:  cp .env.example .env
# 2. Fill in the required API keys and credentials for your environment.
# 3. NEVER commit your real .env file or credentials to source control.
#
# DEPLOYMENT:
# - Frontend (Netlify): See frontend/.env.example
# - Node Backend (Render): See backend/.env.example
# - Python Backend (Render): See backend-python/.env.example
# ==============================================================================

# =========================
# APPLICATION
# =========================
NODE_ENV=development
APP_NAME=MITYRA
APP_VERSION=1.0.0
PORT=5001
PYTHON_PORT=8000

# =========================
# FRONTEND
# =========================
NEXT_PUBLIC_APP_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3001
NEXT_PUBLIC_API_URL=http://localhost:5001/api

# =========================
# NODE BACKEND
# =========================
BACKEND_BASE_URL=http://127.0.0.1:5001
ADMIN_EMAIL=admin@mityra.com
ADMIN_PASSWORD=YOUR_ADMIN_PASSWORD_HERE
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=YOUR_BCRYPT_PASSWORD_HASH_HERE
# VTO backend URL for Node backend (change when switching AWS instances)
AWS_VTO_URL=http://YOUR_AWS_GPU_INSTANCE_PUBLIC_IP:8000

# =========================
# POSTGRESQL / DATABASE
# =========================
DATABASE_URL=postgresql://YOUR_DB_USER:YOUR_DB_PASSWORD@localhost:5432/mityra_db?sslmode=require
DIRECT_URL=postgresql://YOUR_DB_USER:YOUR_DB_PASSWORD@localhost:5432/mityra_db
REDIS_URL=redis://localhost:6379/0

# =========================
# FIREBASE AUTH
# =========================
# Client-side SDK (Public)
NEXT_PUBLIC_FIREBASE_API_KEY=YOUR_FIREBASE_API_KEY_HERE
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=YOUR_FIREBASE_PROJECT_ID.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=YOUR_FIREBASE_PROJECT_ID_HERE
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=YOUR_FIREBASE_PROJECT_ID.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=YOUR_FIREBASE_SENDER_ID_HERE
NEXT_PUBLIC_FIREBASE_APP_ID=YOUR_FIREBASE_APP_ID_HERE
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=YOUR_FIREBASE_MEASUREMENT_ID_HERE

# Server-side SDK (Private Admin Service Account)
FIREBASE_PROJECT_ID=YOUR_FIREBASE_PROJECT_ID_HERE
FIREBASE_CLIENT_EMAIL=YOUR_FIREBASE_CLIENT_EMAIL_HERE
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_FIREBASE_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"
FORCE_MOCK_FIREBASE=false

# =========================
# AWS
# =========================
AWS_ACCESS_KEY_ID=YOUR_AWS_ACCESS_KEY_ID_HERE
AWS_SECRET_ACCESS_KEY=YOUR_AWS_SECRET_ACCESS_KEY_HERE
AWS_REGION=us-east-1
AWS_S3_BUCKET_NAME=YOUR_AWS_S3_BUCKET_NAME_HERE
AWS_EC2_GPU_INSTANCE_IP=YOUR_AWS_GPU_INSTANCE_PUBLIC_IP_HERE

# =========================
# VIRTUAL TRY-ON / CATVTON
# =========================
NEXT_PUBLIC_VTO_BACKEND_URL=http://YOUR_AWS_GPU_INSTANCE_PUBLIC_IP:8000
VTO_BACKEND_URL=http://YOUR_AWS_GPU_INSTANCE_PUBLIC_IP:8000
VTO_TIMEOUT_MS=75000
CATVTON_MODEL_PATH=zhengchong/CatVTON
BASE_DIFFUSION_MODEL=runwayml/stable-diffusion-inpainting

# =========================
# KWS / VOICE SEARCH
# =========================
KWS_API_URL=http://localhost:5001/api/kws
KWS_MODEL_PATH=pose_landmarker.task
KWS_CONFIDENCE_THRESHOLD=0.75

# =========================
# PRODUCT IMPORT / SCRAPING
# =========================
SCRAPINGDOG_API_KEY=YOUR_SCRAPINGDOG_API_KEY_HERE
JINA_READER_URL=https://r.jina.ai
RAPIDAPI_KEY=YOUR_RAPIDAPI_KEY_HERE
REACT_APP_RAPIDAPI_KEY=YOUR_RAPIDAPI_KEY_HERE
REACT_APP_SEARCH_HOST=real-time-product-search.p.rapidapi.com
QUICKCOMMERCE_API_KEY=YOUR_QUICKCOMMERCE_API_KEY_HERE

# =========================
# AMAZON
# =========================
AMAZON_AFFILIATE_TAG=YOUR_AMAZON_AFFILIATE_TAG_HERE
AMAZON_RAPIDAPI_HOST=real-time-amazon-data.p.rapidapi.com

# =========================
# FLIPKART
# =========================
FLIPKART_AFFILIATE_ID=YOUR_FLIPKART_AFFILIATE_ID_HERE
FLIPKART_AFFILIATE_TOKEN=YOUR_FLIPKART_AFFILIATE_TOKEN_HERE

# =========================
# MYNTRA
# =========================
MYNTRA_AFFILIATE_ID=YOUR_MYNTRA_AFFILIATE_ID_HERE

# =========================
# AJIO
# =========================
AJIO_AFFILIATE_ID=YOUR_AJIO_AFFILIATE_ID_HERE
AJIO_IMAGE_CDN_BASE=https://assets-jiocdn.ajio.com

# =========================
# MEESHO
# =========================
MEESHO_AFFILIATE_ID=YOUR_MEESHO_AFFILIATE_ID_HERE

# =========================
# OPENAI
# =========================
OPENAI_API_KEY=YOUR_OPENAI_API_KEY_HERE
OPENAI_MODEL=gpt-4o

# =========================
# HUGGING FACE
# =========================
HUGGINGFACE_TOKEN=YOUR_HUGGINGFACE_TOKEN_HERE
# VTO Config
AWS_VTO_URL=http://localhost:8000

# =========================
# REPLICATE
# =========================
REPLICATE_API_TOKEN=YOUR_REPLICATE_API_TOKEN_HERE

# =========================
# PAYMENTS / CREDITS
# =========================
NEXT_PUBLIC_RAZORPAY_KEY_ID=YOUR_RAZORPAY_KEY_ID_HERE
RAZORPAY_KEY_ID=YOUR_RAZORPAY_KEY_ID_HERE
RAZORPAY_KEY_SECRET=YOUR_RAZORPAY_KEY_SECRET_HERE
RAZORPAY_WEBHOOK_SECRET=YOUR_RAZORPAY_WEBHOOK_SECRET_HERE
INITIAL_FREE_CREDITS=5
CREDIT_COST_PER_TRYON=1

# =========================
# RATE LIMITING / SECURITY
# =========================
JWT_SECRET=YOUR_JWT_SECRET_KEY_HERE
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# =========================
# OTHER REQUIRED SERVICES
# =========================
CLOUDINARY_CLOUD_NAME=YOUR_CLOUDINARY_CLOUD_NAME_HERE
CLOUDINARY_API_KEY=YOUR_CLOUDINARY_API_KEY_HERE
CLOUDINARY_API_SECRET=YOUR_CLOUDINARY_API_SECRET_HERE
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
