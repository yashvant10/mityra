# ==============================================================================
# MITYRA Python/FastAPI Backend — Environment Variables
# ==============================================================================
# Copy to .env and fill in your values.
# All variables here are server-only secrets.
# ==============================================================================

# ─── APPLICATION ─────────────────────────────────────────────────────────────
PORT=8000

# ─── CORS / FRONTEND ────────────────────────────────────────────────────────
# Set to your Netlify URL in production (e.g. https://mityra.netlify.app)
FRONTEND_URL=http://localhost:3002

# ─── FIREBASE ADMIN ─────────────────────────────────────────────────────────
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"

# ─── CLOUDINARY ─────────────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ─── PRODUCT SCRAPING / SEARCH ──────────────────────────────────────────────
RAPIDAPI_KEY=
REACT_APP_RAPIDAPI_KEY=

# ─── AI ──────────────────────────────────────────────────────────────────────
GEMINI_API_KEY=
OPENAI_API_KEY=

# ─── ADMIN ───────────────────────────────────────────────────────────────────
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=
JWT_SECRET=

# ─── CACHE ───────────────────────────────────────────────────────────────────
REDIS_URL=

# ─── OTHER ───────────────────────────────────────────────────────────────────
BACKEND_BASE_URL=http://127.0.0.1:5002
FORCE_MOCK_FIREBASE=false
